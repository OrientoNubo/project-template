# ===== 系統／工具雜項 =====
.DS_Store
Thumbs.db
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.venv/
venv/
*.egg-info/
.env

# ===== 非追蹤目錄：忽略內容，僅保留目錄骨架（.gitkeep）=====

# repos/ — 外部 clone 的 codebase
repos/*
!repos/.gitkeep

# weights/ — 模型權重
weights/*
!weights/.gitkeep
!weights/ours/
weights/ours/*
!weights/ours/.gitkeep

# data/ — 資料（datasets 為機器本地 symlink，不追蹤）
data/*
!data/.gitkeep
!data/scripts/
!data/testdata/
data/scripts/*
!data/scripts/.gitkeep
data/testdata/*
!data/testdata/.gitkeep

# _tmp/ — 臨時輸出
_tmp/*
!_tmp/.gitkeep

# _bak/ — 備份壓縮包
_bak/*
!_bak/.gitkeep
