# ===== System / tooling misc =====
.DS_Store
Thumbs.db
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.venv/
venv/
*.egg-info/
.env

# ===== Untracked dirs: ignore contents, keep only the directory skeleton (.gitkeep) =====

# repos/ — externally cloned codebases
repos/*
!repos/.gitkeep

# weights/ — model weights
weights/*
!weights/.gitkeep
!weights/ours/
weights/ours/*
!weights/ours/.gitkeep

# data/ — data (datasets is a machine-local symlink, not tracked)
data/*
!data/.gitkeep
!data/scripts/
!data/testdata/
data/scripts/*
!data/scripts/.gitkeep
data/testdata/*
!data/testdata/.gitkeep

# _tmp/ — temporary output
_tmp/*
!_tmp/.gitkeep

# _bak/ — backup archives
_bak/*
!_bak/.gitkeep
